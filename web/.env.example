# Copy to .env.local for local dev; on Vercel, set these as Project env vars.

# Auth.js encryption secret - generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-domain>/api/auth/callback/google
# (http://localhost:3000/api/auth/callback/google for local dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The Cloudflare Worker backend. Local dev default matches `npm run server:dev`.
CAREER_WATCH_WORKER_URL=http://127.0.0.1:8787
